# Folder on your computer that holds your design references.
# Drop new references into its _inbox/ folder; Claude files them into sections.
INSPO_DIR=~/Pictures/Inspo   # gets _inbox/ plus web/ mobile/ presentation/ illustration/ typography/ misc/

# Optional: lets the library analyse references automatically.
# Without it you can still analyse via Claude Desktop / Claude Code over MCP.
ANTHROPIC_API_KEY=

# Optional overrides
# INSPO_MODEL=claude-opus-5-5
# PORT=4545
# AUTO_ANALYZE=true
# AUTO_ORGANIZE=true   # file analysed _inbox items into web/, mobile/, presentation/…
