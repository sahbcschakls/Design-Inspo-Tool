# Folder on your computer that holds your design references.
# Drop images in here (subfolders become "collections").
INSPO_DIR=~/Pictures/Inspo

# Optional: lets the library analyse references automatically.
# Without it you can still analyse via Claude Desktop / Claude Code over MCP.
ANTHROPIC_API_KEY=

# Optional overrides
# INSPO_MODEL=claude-opus-5-5
# PORT=4545
# AUTO_ANALYZE=true
